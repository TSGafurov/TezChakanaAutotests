<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
     Регрессионные проверки известных багов (KnownBugsTest, группа "known-bugs").
     Пока баг не исправлен, тест падает - это ожидаемо. Не входит в testng.xml /
     testng-safe.xml, чтобы основной прогон оставался зелёным:
       mvn test -DsuiteXmlFile=src/test/resources/testng-known-bugs.xml
-->
<suite name="TezChakana Known Bugs" verbose="1">
    <listeners>
        <listener class-name="com.tezchakana.tests.ScreenshotOnFailureListener"/>
    </listeners>
    <test name="Known Bugs">
        <classes>
            <class name="com.tezchakana.tests.KnownBugsTest"/>
        </classes>
    </test>
</suite>
