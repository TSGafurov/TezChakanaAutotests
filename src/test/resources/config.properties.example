appium.url=http://127.0.0.1:4723
app.package=uz.agrobank.chakanaexpress
app.activity=.MainActivity

# Реальный личный аккаунт владельца проекта на живом бэкенде, не изолированный
# QA-аккаунт (см. project_real_account_live_backend в памяти проекта). Именно
# поэтому эти два значения не хранятся в config.properties, закоммиченном в git
# (см. .gitignore) - скопируй этот файл в config.properties рядом и подставь
# реальные phone.number/otp.code, либо передавай их флагами -Dphone.number=...
# -Dotp.code=... без правки файла вообще.
phone.number=CHANGE_ME
otp.code=CHANGE_ME

store.name=Eco Bazar
category.water=Suv
product.name=Suv Hydrolife gazsiz 330 ml

# Категория/товар для тестов навигации и корзины (HOME/STORE/CART), не связанных с
# оформлением заказа. "Suv" не используется здесь намеренно - она требует прокрутки
# списка категорий, а тап по прокрученной плитке сейчас нестабилен (см. docs/exploration-notes.md,
# известная проблема с прокруткой Suv). "Uy uchun bozorlik" - первая категория в
# списке, тап без прокрутки работает стабильно.
category.grocery=Uy uchun bozorlik
# Переименован в каталоге 2026-08-29 (проверено вживую): раньше "Oq boshli karam, 1
# dona", теперь просто "Karam, 1 dona" - старое значение перестало матчиться и валило
# addProductToCart() таймаутом на всех тестах, использующих groceryProductName().
# Заменён на "Kartoshka, sariq, 1 kg" 2026-08-29 (тот же экран/категория): "Karam, 1
# dona" упирается в реальный потолок количества =1 (тап "+" в сетке магазина без
# эффекта после первой единицы; в мини-корзине степпер при этом визуально показывает
# "2", но сумма верно продолжает считать за 1 шт. - несогласованность отображения
# степпера с лимитом, см. Known issue 16 в exploration-notes.md) - ломало тесты на
# изменение количества (CART-03, STORE-04). "Kartoshka, sariq, 1 kg" - весовой товар
# без такого лимита, проверено вживую (1→2, сумма пересчитывается корректно).
product.grocery=Kartoshka, sariq, 1 kg

# Сохранённые адреса реального аккаунта (см. предупреждение выше про phone.number) -
# используются в HOME-05, чтобы переключиться на адрес без покрытия доставки и
# гарантированно увидеть смену состояния Home, затем вернуться на исходный адрес.
address.default=Chust
address.alternate=Yunusobod

# Запросы для поиска на карте "Manzil qo'shish" (не для выбора из уже сохранённых
# адресов, см. address.default/address.alternate выше) - используются в
# AddressCoverageTest, чтобы надёжно поставить известный рабочий адрес (Chust, есть
# покрытие доставки) и заведомо вне зоны доставки (Tashkent) через один и тот же,
# проверенный вживую 2026-08-28 путь (шапка Home -> "Manzil qo'shish" -> поиск ->
# первый результат -> Tasdiqlash -> Saqlash), а не полагаться на точное совпадение с
# текстом уже сохранённой карточки.
address.search.chust=chust
address.search.no.coverage=tashkent

reference.screen.width=1080
reference.screen.height=2400
