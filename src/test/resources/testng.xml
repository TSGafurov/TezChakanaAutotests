<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
     Полный регресс: все подключённые ниже классы, без фильтра по группам - как "safe", так
     и "mutating" тесты (см. group на @Test аннотациях каждого метода). "destructive"
     (OrderErrorTest/OrderRetryTest) сюда намеренно не подключены - см. комментарий про
     утечку реальных заказов ниже. Для автоматического CI-safe подмножества (только "safe",
     без мутации реального аккаунта) см. testng-safe.xml:
       mvn test -DsuiteXmlFile=src/test/resources/testng-safe.xml
-->
<suite name="TezChakana Suite" verbose="1">
    <listeners>
        <listener class-name="com.tezchakana.tests.ScreenshotOnFailureListener"/>
        <listener class-name="com.tezchakana.tests.RetryAnalyzerTransformer"/>
    </listeners>
    <test name="Checkout Flow">
        <classes>
            <class name="com.tezchakana.tests.CheckoutFlowTest"/>
        </classes>
    </test>
    <test name="Home and Onboarding">
        <classes>
            <class name="com.tezchakana.tests.HomeAndOnboardingTest"/>
        </classes>
    </test>
    <test name="Store and Cart">
        <classes>
            <!-- CART-02/03/04 были временно исключены (2026-08-25) из-за
                 addFirstRecommendedItem/increaseQuantity/clearCart, тапавших по
                 фиксированным координатам - при промахе тап проваливался через
                 смерженный на весь мини-корзину CTA "Savat\nTo'lovga o'tish", что
                 привело к непреднамеренному оформлению реальных заказов
                 (TEZ00082/83/84, впоследствии отменены через приложение). 2026-08-26
                 все три метода переписаны на поиск по элементам (accessibility id /
                 xpath относительно проверенного родителя) вместо координат - см.
                 CartScreen.java и project-accidental-order-placement-incident в
                 памяти проекта. Включены обратно. -->
            <class name="com.tezchakana.tests.StoreAndCartTest"/>
        </classes>
    </test>
    <test name="Checkout Details">
        <classes>
            <class name="com.tezchakana.tests.CheckoutDetailsTest"/>
        </classes>
    </test>
    <test name="Profile Authorized">
        <classes>
            <class name="com.tezchakana.tests.ProfileAuthorizedTest"/>
        </classes>
    </test>
    <test name="Details">
        <classes>
            <class name="com.tezchakana.tests.DetailsTest"/>
        </classes>
    </test>
    <test name="Addresses">
        <classes>
            <class name="com.tezchakana.tests.AddressesTest"/>
        </classes>
    </test>
    <test name="Profile Guest">
        <classes>
            <class name="com.tezchakana.tests.ProfileGuestTest"/>
        </classes>
    </test>
    <test name="Settings">
        <classes>
            <class name="com.tezchakana.tests.SettingsTest"/>
        </classes>
    </test>
    <test name="Language Switch">
        <classes>
            <!-- Изменяет язык интерфейса реального аккаунта туда-обратно (см. javadoc
                 класса) - отдельный <test>, не внутри "Settings", чтобы явно видеть в
                 отчёте, если finally-возврат на узбекский не отработал. -->
            <class name="com.tezchakana.tests.LanguageSwitchTest"/>
        </classes>
    </test>
    <test name="Product Card Quantity">
        <classes>
            <class name="com.tezchakana.tests.ProductCardQuantityTest"/>
        </classes>
    </test>
    <test name="Cards">
        <classes>
            <class name="com.tezchakana.tests.CardsTest"/>
        </classes>
    </test>
    <test name="Orders">
        <classes>
            <class name="com.tezchakana.tests.OrdersTest"/>
        </classes>
    </test>
    <test name="Notifications">
        <classes>
            <class name="com.tezchakana.tests.NotificationsTest"/>
        </classes>
    </test>
    <!-- OrderErrorTest/OrderRetryTest ВРЕМЕННО ИСКЛЮЧЕНЫ из сьюта 2026-08-31: обнаружено
         вживую, что оба теста могут оставлять РЕАЛЬНЫЕ подтверждённые заказы
         (TEZ00167/TEZ00168/TEZ00169 - 3 штуки за день, отменены через приложение)
         несмотря на то, что `verifyOrderErrorShown()` корректно видел экран ошибки в
         момент проверки. Первая попытка починки (`BaseTest.toggleNetwork()` теперь ждёт
         физического подтверждения через /proc/net/route) устранила один реальный race,
         но TEZ00169 создался УЖЕ ПОСЛЕ этого фикса - похоже, это эмулятор, и
         `svc wifi/data disable` не обрывает уже открытое keep-alive HTTP-соединение,
         только блокирует НОВЫЕ (см. разбор ORD-02 в docs/exploration-notes.md). Оба
         теста теперь также сверяют список заказов до/после (`OrdersScreen.
         topOrderNumber()`) и падают ГРОМКО, если заказ всё-таки появился - это
         сработало (поймало TEZ00169), но не заменяет надёжной блокировки сети. Не
         включать обратно, пока не реализована пакетная блокировка (`iptables`/аналог)
         конкретного хоста бэкенда, либо без явного согласия владельца на риск ещё
         одного реального заказа за попытку. -->
    <test name="Address Coverage">
        <classes>
            <!-- Не идемпотентен - каждый прогон добавляет в адресную книгу ещё один
                 адрес "Chust" (владелец аккаунта осведомлён и одобрил, 2026-08-28).
                 См. javadoc AddressCoverageTest. -->
            <class name="com.tezchakana.tests.AddressCoverageTest"/>
        </classes>
    </test>
</suite>
