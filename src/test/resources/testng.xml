<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TezChakana Suite" verbose="1">
    <test name="Checkout Flow">
        <classes>
            <class name="com.tezchakana.tests.CheckoutFlowTest"/>
        </classes>
    </test>
    <test name="Home and Onboarding">
        <classes>
            <class name="com.tezchakana.tests.HomeAndOnboardingTest"/>
        </classes>
    </test>
    <test name="Store and Cart">
        <classes>
            <!-- CART-02/03/04 временно исключены (2026-08-25): addFirstRecommendedItem/
                 increaseQuantity/clearCart тапают по фиксированным координатам, и при
                 промахе тап проваливается через смерженный на весь мини-корзину CTA
                 "Savat\nTo'lovga o'tish", что могло привести к непреднамеренному
                 оформлению реальных заказов (TEZ00082/83/84, впоследствии отменены).
                 Не включать обратно, пока эти методы не будут переписаны на поиск по
                 элементам с проверкой присутствия вместо координат. -->
            <class name="com.tezchakana.tests.StoreAndCartTest">
                <methods>
                    <include name="addingProductUpdatesCartSummaryAndMiniCart"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Checkout Details">
        <classes>
            <class name="com.tezchakana.tests.CheckoutDetailsTest"/>
        </classes>
    </test>
</suite>
